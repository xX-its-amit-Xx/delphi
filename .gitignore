node_modules/

# Downloaded publisher PDFs: over the 1 MB repo limit and not ours to redistribute.
# The fetch script + checksums are committed; the PDFs are not.
physics/prior-art/raw/*.pdf
*.dom.html
__pycache__/

# Local-only omics rows under non-redistributable licences (e.g. KEGG): never commit or deploy
omics/**/*.local.jsonl.gz

# Fetched paper bodies behind runs/_chains: not every source is licensed for redistribution. The fetch log
# beside them records every URL, status, byte count and SHA-256, so each body is reproducible and checkable.
runs/_chains/raw/
# Unscreened SPARQL responses; the audit now writes them to the OS temp directory instead.
sim-engine/scales/cache/
# Per-generation scale ladders: byte-for-byte inside dashboard/public/blueprint3d/studio-live/scales/<run>.json,
# and rebuilt in seconds by node sim-engine/scales/build.mjs. Each run's scales/index.json and taxon-audit.json
# are committed.
runs/*/scales/gen*.json
