sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> a delphi:Claim ;
    rdfs:label "That real held-out organisms score plausible says almost nothing about whether the design scorer works, because negatives score plausible too." ;
    dct:description "STATUS: a descriptive finding from one blind, family-out held-out evaluation of every scorer version (168 held-out families; SCORER-EVALUATION.md:14), read from the evaluation write-up; it has not been independently replicated or peer reviewed. The write-up reports that 98 to 99.6 % of real held-out organisms score at or above the 0.5 plausibility cut in every version (SCORER-EVALUATION.md:45), while only 12 to 17 % of negatives score below that same cut (SCORER-EVALUATION.md:46), so every version is close to calling everything plausible (SCORER-EVALUATION.md:47). WHAT THIS DOES NOT ESTABLISH: it does not show that any scorer version is useless or wrong, since a scorer could still rank candidates usefully even with a poorly placed cut; it does not give a better threshold or a discrimination metric; and it says nothing about how negatives were constructed beyond what the locators state. It only shows that the share of real organisms scoring high is not, by itself, evidence of a working scorer." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> a delphi:EvidenceItem ;
    rdfs:label "Held-out plausibility scores: real organisms nearly all pass the 0.5 cut, but negatives mostly pass too." ;
    dct:description "Numbers transcribed from SCORER-EVALUATION.md lines 14, 45, 46, 47, 183 and 186: the held-out run size, the real-organism pass rate and negative rejection rate at the 0.5 cut, and two low-scoring families with a worked gulper eel example." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/held-out-families> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/real-pass-rate> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/negative-reject-rate> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/cut> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/min-items> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/family-threshold> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/eurypharyngidae> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/aspredinidae> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/example-score> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/example-distance> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/held-out-families> a schema:PropertyValue ;
    schema:propertyID "held_out_families" ;
    schema:value "168" ;
    schema:description "Held-out families scored family-out in the blind run of every scorer version (SCORER-EVALUATION.md:14)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/real-pass-rate> a schema:PropertyValue ;
    schema:propertyID "real_organisms_at_or_above_cut_percent" ;
    schema:value "98 to 99.6" ;
    schema:description "Percent of real held-out organisms scoring at or above the cut, range across versions (SCORER-EVALUATION.md:45)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/negative-reject-rate> a schema:PropertyValue ;
    schema:propertyID "negatives_below_cut_percent" ;
    schema:value "12 to 17" ;
    schema:description "Percent of negatives scoring below the same cut, range across versions (SCORER-EVALUATION.md:46)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/cut> a schema:PropertyValue ;
    schema:propertyID "plausibility_cut" ;
    schema:value "0.5" ;
    schema:description "Plausibility cut used for both the real-organism and negative rates (SCORER-EVALUATION.md:45-46)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/min-items> a schema:PropertyValue ;
    schema:propertyID "minimum_real_items_per_family" ;
    schema:value "3" ;
    schema:description "Families are listed only if they have at least this many real items (SCORER-EVALUATION.md:183)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/family-threshold> a schema:PropertyValue ;
    schema:propertyID "family_plausible_share_threshold_percent" ;
    schema:value "80" ;
    schema:description "Families with fewer than this percent of real items scoring plausible are flagged (SCORER-EVALUATION.md:183)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/eurypharyngidae> a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae_plausible_of_total" ;
    schema:value "3 of 5" ;
    schema:description "Gulper eels (Eurypharyngidae): 3 of 5 real items score plausible (SCORER-EVALUATION.md:183)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/aspredinidae> a schema:PropertyValue ;
    schema:propertyID "aspredinidae_plausible_of_total" ;
    schema:value "20 of 29" ;
    schema:description "Banjo catfishes (Aspredinidae): 20 of 29 real items score plausible (SCORER-EVALUATION.md:183)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/example-score> a schema:PropertyValue ;
    schema:propertyID "fs-05942_score" ;
    schema:value "0.15" ;
    schema:description "Plausibility score of fs-05942, a gulper eel, an example low scorer (SCORER-EVALUATION.md:186)." .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/example-distance> a schema:PropertyValue ;
    schema:propertyID "fs-05942_nearest_neighbour_distance" ;
    schema:value "0.96" ;
    schema:description "Distance from fs-05942 to its nearest remaining neighbour, the cutlassfish Lepturacanthus savala, once its family is removed (SCORER-EVALUATION.md:186)." .
}

