@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> a delphi:Claim ;
    rdfs:label "Because nearly every negative also scores plausible, the fact that real organisms score plausible says almost nothing about whether the design scorer works." ;
    dct:description "STATUS: a descriptive observation from one blind, family-out held-out run over 168 families, covering every scorer version, as reported in sim-engine/validate/evaluation/SCORER-EVALUATION.md (lines 14, 45, 46, 47). On the 0.5 plausibility cut, 98 to 99.6 % of real held-out organisms score at or above it, yet only 12 to 17 % of negatives score below it, so each version is close to calling everything plausible. This does NOT establish that any scorer version is broken or useless, nor that a version could not separate real from negative by some other measure; it shows only that the share of real organisms scoring high cannot, alone, count as evidence of discrimination. The low-scoring families cited (SCORER-EVALUATION.md:183 and :186) are anecdotal illustrations, not a measured failure rate." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> a delphi:EvidenceItem ;
    rdfs:label "Held-out recall on real organisms versus rejection of negatives at the 0.5 cut, with two low-scoring families" ;
    dct:description "Numbers transcribed from SCORER-EVALUATION.md: held-out size at line 14, real-organism pass rate at line 45, negative rejection rate at line 46, the near-everything-plausible reading at line 47, low-scoring families at line 183, and the gulper eel example at line 186." ;
    schema:additionalProperty sub:prop-families , sub:prop-real-low , sub:prop-real-high , sub:prop-cut , sub:prop-neg-low , sub:prop-neg-high , sub:prop-min-items , sub:prop-threshold , sub:prop-gulper-hit , sub:prop-gulper-total , sub:prop-banjo-hit , sub:prop-banjo-total , sub:prop-score , sub:prop-distance .

  sub:prop-families a schema:PropertyValue ;
    schema:propertyID "heldOutFamilies" ;
    schema:value 168 ;
    schema:description "Held-out families scored family-out in the blind run of every scorer version (SCORER-EVALUATION.md:14)." .

  sub:prop-real-low a schema:PropertyValue ;
    schema:propertyID "realOrganismsAtOrAboveCutLowPercent" ;
    schema:value 98 ;
    schema:description "Lower end of the percentage of real held-out organisms scoring at or above the cut across versions (SCORER-EVALUATION.md:45)." .

  sub:prop-real-high a schema:PropertyValue ;
    schema:propertyID "realOrganismsAtOrAboveCutHighPercent" ;
    schema:value 99.6 ;
    schema:description "Upper end of the same percentage range (SCORER-EVALUATION.md:45)." .

  sub:prop-cut a schema:PropertyValue ;
    schema:propertyID "plausibilityCut" ;
    schema:value 0.5 ;
    schema:description "Plausibility score cut used for both real organisms and negatives (SCORER-EVALUATION.md:45-46)." .

  sub:prop-neg-low a schema:PropertyValue ;
    schema:propertyID "negativesBelowCutLowPercent" ;
    schema:value 12 ;
    schema:description "Lower end of the percentage of negatives scoring below the cut (SCORER-EVALUATION.md:46)." .

  sub:prop-neg-high a schema:PropertyValue ;
    schema:propertyID "negativesBelowCutHighPercent" ;
    schema:value 17 ;
    schema:description "Upper end of the percentage of negatives scoring below the cut (SCORER-EVALUATION.md:46)." .

  sub:prop-min-items a schema:PropertyValue ;
    schema:propertyID "minimumRealItemsPerFamilyForFlagging" ;
    schema:value 3 ;
    schema:description "A family is listed as low only if it has at least this many real items (SCORER-EVALUATION.md:183)." .

  sub:prop-threshold a schema:PropertyValue ;
    schema:propertyID "familyPlausibleSharePercentThreshold" ;
    schema:value 80 ;
    schema:description "Families listed have fewer than this percentage of real items scoring plausible (SCORER-EVALUATION.md:183)." .

  sub:prop-gulper-hit a schema:PropertyValue ;
    schema:propertyID "eurypharyngidaePlausibleItems" ;
    schema:value 3 ;
    schema:description "Eurypharyngidae (gulper eels) real items scoring plausible (SCORER-EVALUATION.md:183)." .

  sub:prop-gulper-total a schema:PropertyValue ;
    schema:propertyID "eurypharyngidaeRealItems" ;
    schema:value 5 ;
    schema:description "Eurypharyngidae real items in total (SCORER-EVALUATION.md:183)." .

  sub:prop-banjo-hit a schema:PropertyValue ;
    schema:propertyID "aspredinidaePlausibleItems" ;
    schema:value 20 ;
    schema:description "Aspredinidae (banjo catfishes) real items scoring plausible (SCORER-EVALUATION.md:183)." .

  sub:prop-banjo-total a schema:PropertyValue ;
    schema:propertyID "aspredinidaeRealItems" ;
    schema:value 29 ;
    schema:description "Aspredinidae real items in total (SCORER-EVALUATION.md:183)." .

  sub:prop-score a schema:PropertyValue ;
    schema:propertyID "fs-05942Score" ;
    schema:value 0.15 ;
    schema:description "Plausibility score of the gulper eel fs-05942 (SCORER-EVALUATION.md:186)." .

  sub:prop-distance a schema:PropertyValue ;
    schema:propertyID "fs-05942NearestNeighbourDistance" ;
    schema:value 0.96 ;
    schema:description "Distance from fs-05942 to its nearest remaining neighbour, the cutlassfish Lepturacanthus savala, once its family is removed (SCORER-EVALUATION.md:186)." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/claude-drafting-agent-part-three> ;
    prov:wasDerivedFrom "sim-engine/validate/evaluation/SCORER-EVALUATION.md:14" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:45" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:46" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:47" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:183" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:186" .
}

