@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/orchestrated-drafting-team> ;
    prov:wasDerivedFrom
      "swarm/benchmark/fixtures/gt-l4-t1.json#results" ,
      "swarm/benchmark/fixtures/gt-l4-t1.json#composite_score_from_the_scorer" ,
      "swarm/benchmark/fixtures/gt-l4-t1.json#verdict.word_validated_withheld" ,
      "swarm/benchmark/fixtures/gt-l4-t1.json#verdict.withheld_because" ,
      "swarm/benchmark/fixtures/gt-l4-t1.json#verdict.scales_not_assessed" ,
      "sim-engine/validate-cli.mjs:17" .
}

sub:pubinfo {
  this: dct:created "2026-11-01T00:00:00Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/orchestrated-drafting-team> ;
    rdfs:label "Draft: winged-zebrafish headline run scores a high 0.878 composite yet fails two of five gates and the validator withholds 'validated'" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType delphi:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/claim/high-composite-with-failing-gates> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/design-validation> ;
    rdfs:comment "UNSIGNED draft, not published: this nanopublication about the winged-zebrafish composite-versus-gates discrepancy carries no signature and has not been published to any nanopublication network; treat it as a candidate record awaiting review." .

  <https://w3id.org/delphi/resource/domain/design-validation> rdfs:label "Design validation" .
}