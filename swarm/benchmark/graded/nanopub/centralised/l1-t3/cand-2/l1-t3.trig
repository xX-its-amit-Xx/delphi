<https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates> a delphi:EvidenceItem ;
    rdfs:label "Winged-zebrafish run: scorer composite 0.878 beside 2 failed, 2 unassessable gates and a withheld 'validated'" ;
    dct:description "Evidence from the fixture swarm/benchmark/fixtures/gt-l4-t1.json, a validate_generation run whose exit code is defined in sim-engine/validate-cli.mjs:17. Run: generated=winged-zebrafish, base=zebrafish-adult, desired phenotype 'a zebrafish that glides at least 5 m from a 1 m launch and survives 10-30 C as an adult'. Each property below names the fixture locator it was read from." ;
    schema:additionalProperty
    [ a schema:PropertyValue ;
      schema:propertyID "composite_score" ;
      schema:value 0.878 ;
      schema:description "Scorer composite 0.878, flagged plausible true, scorer version 1.0.0, from swarm/benchmark/fixtures/gt-l4-t1.json#composite_score_from_the_scorer. Carried through for reference only; it is not the report's verdict and no gate feeds it." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "gates_failed" ;
      schema:value 2 ;
      schema:description "Gates failed = 2 (functional_resolution, physics_check), from swarm/benchmark/fixtures/gt-l4-t1.json#results." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "gates_cannot_assess" ;
      schema:value 2 ;
      schema:description "Gates that cannot be assessed = 2 (genotype_similarity, lean_check), from swarm/benchmark/fixtures/gt-l4-t1.json#results." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "gates_passed" ;
      schema:value 1 ;
      schema:description "Gates passed = 1: phenotype_similarity is the only pass, from swarm/benchmark/fixtures/gt-l4-t1.json#results." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "named_gates_total" ;
      schema:value 5 ;
      schema:description "Named gates total 5 (phenotype_similarity, functional_resolution, physics_check, genotype_similarity, lean_check), from swarm/benchmark/fixtures/gt-l4-t1.json#results." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "scales_not_assessed" ;
      schema:value 3 ;
      schema:description "Biological scales not assessed = 3 (cell, tissue, organ_system), from swarm/benchmark/fixtures/gt-l4-t1.json#verdict.scales_not_assessed." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "word_validated_withheld" ;
      schema:value true ;
      schema:description "word_validated_withheld is true, from swarm/benchmark/fixtures/gt-l4-t1.json#verdict.word_validated_withheld. Reason, from swarm/benchmark/fixtures/gt-l4-t1.json#verdict.withheld_because: 2 gate(s) failed; 2 gate(s) could not be assessed; 3 biological scale(s) could not be assessed; no sequence was compared at any locus." ] ,
    [ a schema:PropertyValue ;
      schema:propertyID "cli_exit_code" ;
      schema:value 1 ;
      schema:description "CLI exit code 1 on this run, from sim-engine/validate-cli.mjs:17, where 0 means all gates pass, 1 means any gate failed, 2 means nothing failed but something was not assessable." ] .