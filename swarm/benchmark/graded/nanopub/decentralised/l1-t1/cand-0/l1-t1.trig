sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/composite-never-beat-its-strongest-term> a delphi:Claim ;
    rdfs:label "The design scorer's composite rank_score has not beaten its own strongest single term, the joint Mahalanobis term, on the primary ranking endpoint P1." ;
    dct:description "STATUS: an observed result from one blind held-out evaluation, not a settled or general law. On endpoint P1 the v1.3.0 rank_score is slightly below the joint Mahalanobis term used alone (difference -0.008, interval -0.020 to 0.002, which includes zero), and over all held-out items it is significantly worse (-0.007, interval -0.013 to -0.002). The dossier reports the comparison only for v1.3.0; the word 'never' is therefore the headline's framing and the quantitative comparison here covers v1.3.0 (SCORER-EVALUATION.md:35, :36). This does NOT establish that the composite is useless: the other components earn their place on secondary endpoints S4 and S5, which the joint term alone fails (SCORER-EVALUATION.md:43). It does NOT show that the P1 gap itself is a real deficit, since the P1 interval spans zero. It does NOT show the result holds on other families, other endpoints, or future scorer versions, and it gives no causal explanation for why the composite does not help on P1." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> a delphi:EvidenceItem ;
    rdfs:label "Blind held-out comparison of v1.3.0 rank_score against its single terms on P1" ;
    dct:description "Numbers taken from SCORER-EVALUATION.md in sim-engine/validate/evaluation/, from the blind held-out run of the scorer version (168 held-out families, scored family-out; line 14), run by an evaluator who built neither the scorer nor the benchmark (line 13). Each property below names its own source line." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/families> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/rank-p1> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-diff> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-ci-low> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-ci-high> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-diff> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-ci-low> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-ci-high> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-diff> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-ci-low> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-ci-high> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-p1> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/families> a schema:PropertyValue ;
    schema:propertyID "held_out_family_count" ;
    schema:value "168"^^xsd:integer ;
    schema:description "Number of held-out families, scored family-out (SCORER-EVALUATION.md:14)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/rank-p1> a schema:PropertyValue ;
    schema:propertyID "v1.3.0_rank_score_P1" ;
    schema:value "0.875"^^xsd:decimal ;
    schema:description "P1 of v1.3.0 rank_score, which beats nearest-neighbour distance (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-diff> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_nearest_neighbour_P1" ;
    schema:value "0.032"^^xsd:decimal ;
    schema:description "Difference in P1, rank_score over nearest-neighbour distance (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-ci-low> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_nearest_neighbour_P1_ci_lower" ;
    schema:value "0.026"^^xsd:decimal ;
    schema:description "Lower interval bound for the nearest-neighbour difference (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-ci-high> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_nearest_neighbour_P1_ci_upper" ;
    schema:value "0.040"^^xsd:decimal ;
    schema:description "Upper interval bound for the nearest-neighbour difference (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-diff> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_joint_mahalanobis_P1" ;
    schema:value "-0.008"^^xsd:decimal ;
    schema:description "Difference in P1, rank_score minus the joint Mahalanobis term alone; negative, not a win (SCORER-EVALUATION.md:35)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-ci-low> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_joint_mahalanobis_P1_ci_lower" ;
    schema:value "-0.020"^^xsd:decimal ;
    schema:description "Lower interval bound for the joint-term P1 difference (SCORER-EVALUATION.md:35)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-ci-high> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_joint_mahalanobis_P1_ci_upper" ;
    schema:value "0.002"^^xsd:decimal ;
    schema:description "Upper interval bound for the joint-term P1 difference; the interval includes zero (SCORER-EVALUATION.md:35)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-diff> a schema:PropertyValue ;
    schema:propertyID "rank_score_minus_joint_mahalanobis_all_held_out_items" ;
    schema:value "-0.007"^^xsd:decimal ;
    schema:description "Difference over all held-out items; the composite is significantly worse than the joint term alone (SCORER-EVALUATION.md:36)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-ci-low> a schema:PropertyValue ;
    schema:propertyID "all_items_difference_ci_lower" ;
    schema:value "-0.013"^^xsd:decimal ;
    schema:description "Lower interval bound over all held-out items (SCORER-EVALUATION.md:36)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-ci-high> a schema:PropertyValue ;
    schema:propertyID "all_items_difference_ci_upper" ;
    schema:value "-0.002"^^xsd:decimal ;
    schema:description "Upper interval bound over all held-out items; entirely below zero (SCORER-EVALUATION.md:36)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-p1> a schema:PropertyValue ;
    schema:propertyID "joint_mahalanobis_alone_P1" ;
    schema:value "0.883"^^xsd:decimal ;
    schema:description "P1 reached by the joint Mahalanobis term alone, which also passes all three primary endpoints by itself (SCORER-EVALUATION.md:38)." .
}

