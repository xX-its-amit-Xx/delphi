@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/composite-never-beat-its-strongest-term> a delphi:Claim ;
    rdfs:label "On the blind held-out run, the design scorer's composite rank_score did not beat its own joint Mahalanobis term used alone on primary endpoint P1." ;
    dct:description "Status: an observed result from a single blind, family-out held-out evaluation of scorer version 1.3.0 (168 held-out families), run by an evaluator who built neither scorer nor benchmark (SCORER-EVALUATION.md:13, :14). The composite beats nearest-neighbour distance on P1 but not the joint Mahalanobis term alone (difference -0.008, CI -0.020 to 0.002, which spans zero), and is significantly worse over all held-out items (-0.007, CI -0.013 to -0.002) (SCORER-EVALUATION.md:33, :35, :36). This does NOT establish that the composite is useless: the other components earn their place on secondary endpoints S4 and S5, which the joint term fails (SCORER-EVALUATION.md:43). It does NOT show the composite is worse on P1 specifically (that interval includes zero), and says nothing about other scorer versions, other held-out sets, or dev results, which count for nothing." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> a delphi:EvidenceItem ;
    rdfs:label "Held-out comparison of the v1.3.0 composite against its single terms on P1 and over all items" ;
    dct:description "Numbers reported from the blind held-out run in sim-engine/validate/evaluation/SCORER-EVALUATION.md, lines 14, 33, 35, 36, 38 and 43; each property below names its source line." ;
    schema:additionalProperty
      [ a schema:PropertyValue ; schema:propertyID "held-out-families" ; schema:value "168" ; schema:description "Held-out families, scored family-out (SCORER-EVALUATION.md:14)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "scorer-version" ; schema:value "1.3.0" ; schema:description "Scorer version evaluated (SCORER-EVALUATION.md:33)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "rank-score-P1" ; schema:value "0.875" ; schema:description "rank_score on endpoint P1 (SCORER-EVALUATION.md:33)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-nearest-neighbour" ; schema:value "0.032" ; schema:description "Advantage over nearest-neighbour distance on P1, positive (SCORER-EVALUATION.md:33)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-nearest-neighbour-ci-low" ; schema:value "0.026" ; schema:description "Lower CI bound of that advantage (SCORER-EVALUATION.md:33)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-nearest-neighbour-ci-high" ; schema:value "0.040" ; schema:description "Upper CI bound of that advantage (SCORER-EVALUATION.md:33)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "joint-term-P1" ; schema:value "0.883" ; schema:description "P1 reached by the joint Mahalanobis term alone, which passes all three primary endpoints (SCORER-EVALUATION.md:38)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-joint-P1" ; schema:value "-0.008" ; schema:description "rank_score minus joint term alone on P1 (SCORER-EVALUATION.md:35)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-joint-P1-ci-low" ; schema:value "-0.020" ; schema:description "Lower CI bound on P1 difference (SCORER-EVALUATION.md:35)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-joint-P1-ci-high" ; schema:value "0.002" ; schema:description "Upper CI bound on P1 difference; interval includes zero (SCORER-EVALUATION.md:35)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-joint-all-items" ; schema:value "-0.007" ; schema:description "Composite minus joint term over all held-out items, significantly worse (SCORER-EVALUATION.md:36)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-joint-all-items-ci-low" ; schema:value "-0.013" ; schema:description "Lower CI bound over all items (SCORER-EVALUATION.md:36)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "diff-vs-joint-all-items-ci-high" ; schema:value "-0.002" ; schema:description "Upper CI bound over all items (SCORER-EVALUATION.md:36)." ] ,
      [ a schema:PropertyValue ; schema:propertyID "secondary-endpoints-where-other-components-help" ; schema:value "S4, S5" ; schema:description "Secondary endpoints 4 and 5, which the joint term alone fails (SCORER-EVALUATION.md:43)." ] .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/claude-drafting-agent-1> ;
    prov:wasDerivedFrom <sim-engine/validate/evaluation/SCORER-EVALUATION.md:13> ,
      <sim-engine/validate/evaluation/SCORER-EVALUATION.md:14> ,
      <sim-engine/validate/evaluation/SCORER-EVALUATION.md:33> ,
      <sim-engine/validate/evaluation/SCORER-EVALUATION.md:35> ,
      <sim-engine/validate/evaluation/SCORER-EVALUATION.md:36> ,
      <sim-engine/validate/evaluation/SCORER-EVALUATION.md:38> ,
      <sim-engine/validate/evaluation/SCORER-EVALUATION.md:43> .
}

