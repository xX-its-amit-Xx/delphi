  this: dct:created "2026-11-01T12:00:00Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/claude-drafting-agent-1> ;
    rdfs:label "Draft: scorer composite has not beaten its strongest single term on P1" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType delphi:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/claim/composite-never-beat-its-strongest-term> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/design-scorer-evaluation> ;
    rdfs:comment "Unsigned draft, not published: this nanopublication has no signature and has not been submitted to any nanopublication server." .

  <https://w3id.org/delphi/resource/domain/design-scorer-evaluation> rdfs:label "Design scorer evaluation" .
}
