sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/composite-never-beat-its-strongest-term> a delphi:Claim ;
    rdfs:label "On the blind held-out run, the scorer's composite rank_score never beat its own joint Mahalanobis term used alone on primary endpoint P1." ;
    dct:description "Status: an observed result from the blind held-out evaluation of scorer version 1.3.0 (168 held-out families, scored family-out), run by an evaluator who built neither scorer nor benchmark (SCORER-EVALUATION.md:13, :14). It is a descriptive finding about this one scorer on this one held-out set, not a proven property. It does NOT establish that the composite is useless: it beats nearest-neighbour distance on P1, and the other components earn their place on secondary endpoints S4 and S5 which the joint term alone fails (SCORER-EVALUATION.md:33, :43). It does NOT show that the joint term is better on every endpoint or on other data, and the P1 difference to the joint term has a confidence interval that spans zero, so only the all-items comparison is significantly worse (SCORER-EVALUATION.md:35, :36). Dev results count for nothing here." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> a delphi:EvidenceItem ;
    rdfs:label "Blind held-out comparison of rank_score against the joint Mahalanobis term alone" ;
    dct:description "Numbers read from SCORER-EVALUATION.md lines 14, 33, 35, 36, 38 and 43: each is from the blind held-out run of the scorer version named, over 168 held-out families scored family-out." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/families>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/version>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/p1-rank-score>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/diff-nn>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-nn-low>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-nn-high>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/diff-joint-p1>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-p1-low>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-p1-high>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/diff-joint-all>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-all-low>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-all-high>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/p1-joint>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/secondary-endpoint-a>,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/secondary-endpoint-b> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/families> a schema:PropertyValue ;
    schema:propertyID "held-out-families" ; schema:value 168 ;
    schema:description "Held-out families, scored family-out (SCORER-EVALUATION.md:14)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/version> a schema:PropertyValue ;
    schema:propertyID "scorer-version" ; schema:value "1.3.0" ;
    schema:description "Scorer version whose rank_score was compared (SCORER-EVALUATION.md:33)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/p1-rank-score> a schema:PropertyValue ;
    schema:propertyID "p1-rank-score" ; schema:value 0.875 ;
    schema:description "P1 of rank_score in v1.3.0 (SCORER-EVALUATION.md:33)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/diff-nn> a schema:PropertyValue ;
    schema:propertyID "p1-difference-vs-nearest-neighbour" ; schema:value 0.032 ;
    schema:description "rank_score minus nearest-neighbour distance on P1, positive (SCORER-EVALUATION.md:33)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-nn-low> a schema:PropertyValue ;
    schema:propertyID "p1-vs-nearest-neighbour-ci-lower" ; schema:value 0.026 ;
    schema:description "Lower CI bound of the difference versus nearest-neighbour (SCORER-EVALUATION.md:33)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-nn-high> a schema:PropertyValue ;
    schema:propertyID "p1-vs-nearest-neighbour-ci-upper" ; schema:value 0.040 ;
    schema:description "Upper CI bound of the difference versus nearest-neighbour (SCORER-EVALUATION.md:33)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/diff-joint-p1> a schema:PropertyValue ;
    schema:propertyID "p1-difference-vs-joint-term-magnitude" ; schema:value 0.008 ;
    schema:description "Magnitude of the P1 difference rank_score minus joint term; the sign is negative (SCORER-EVALUATION.md:35)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-p1-low> a schema:PropertyValue ;
    schema:propertyID "p1-vs-joint-ci-lower-magnitude" ; schema:value 0.020 ;
    schema:description "Lower CI bound is negative, magnitude 0.020 (SCORER-EVALUATION.md:35)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-p1-high> a schema:PropertyValue ;
    schema:propertyID "p1-vs-joint-ci-upper-magnitude" ; schema:value 0.002 ;
    schema:description "Upper CI bound is positive, 0.002, so the interval includes zero (SCORER-EVALUATION.md:35)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/diff-joint-all> a schema:PropertyValue ;
    schema:propertyID "all-items-difference-vs-joint-term-magnitude" ; schema:value 0.007 ;
    schema:description "Over all held-out items the composite is worse than the joint term alone by 0.007; the sign is negative (SCORER-EVALUATION.md:36)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-all-low> a schema:PropertyValue ;
    schema:propertyID "all-items-ci-lower-magnitude" ; schema:value 0.013 ;
    schema:description "Lower CI bound is negative, magnitude 0.013 (SCORER-EVALUATION.md:36)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/ci-joint-all-high> a schema:PropertyValue ;
    schema:propertyID "all-items-ci-upper-magnitude" ; schema:value 0.002 ;
    schema:description "Upper CI bound is negative, magnitude 0.002, so the interval excludes zero (SCORER-EVALUATION.md:36)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/p1-joint> a schema:PropertyValue ;
    schema:propertyID "p1-joint-mahalanobis-alone" ; schema:value 0.883 ;
    schema:description "P1 of the joint Mahalanobis term used alone; it passes all three primary endpoints by itself (SCORER-EVALUATION.md:38)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/secondary-endpoint-a> a schema:PropertyValue ;
    schema:propertyID "secondary-endpoint-number-a" ; schema:value 4 ;
    schema:description "Secondary endpoint S4, which the joint term alone fails and the other components pass (SCORER-EVALUATION.md:43)." .
  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/secondary-endpoint-b> a schema:PropertyValue ;
    schema:propertyID "secondary-endpoint-number-b" ; schema:value 5 ;
    schema:description "Secondary endpoint S5, which the joint term alone fails and the other components pass (SCORER-EVALUATION.md:43)." .
}

