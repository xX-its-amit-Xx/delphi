@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> a delphi:Claim ;
    rdfs:label "That real held-out organisms score plausible says almost nothing about whether the design scorer works, because negatives score plausible too." ;
    dct:description "Status: a descriptive observation read from the blind held-out evaluation write-up (SCORER-EVALUATION.md, lines 14 and 45 to 47), reported by that document for every scorer version; it is one internal evaluation, not an independent replication. What it supports: at the 0.5 cut on the plausibility score, almost all real organisms pass and most negatives pass as well, so the pass rate on real organisms cannot separate a working scorer from one that calls everything plausible. What it does NOT establish: it does not show that any scorer version is broken or useless, it does not measure how well any version ranks or discriminates, and it says nothing about performance at other cuts or on other scores. It only shows that this particular statistic is a weak test." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> a delphi:EvidenceItem ;
    rdfs:label "Held-out plausibility pass rates: real organisms near ceiling, negatives mostly passing too" ;
    dct:description "Numbers transcribed from SCORER-EVALUATION.md. Setup (line 14): held-out families scored family-out in a blind run of every scorer version. Pass rates (lines 45 to 47): real organisms at or above the 0.5 cut versus negatives below it. Low-scoring families and one example (lines 183 and 186) are included to show where real organisms do fail." ;
    schema:additionalProperty
      sub:pv-families, sub:pv-real-low, sub:pv-real-high, sub:pv-cut,
      sub:pv-neg-low, sub:pv-neg-high, sub:pv-min-items, sub:pv-share-threshold,
      sub:pv-gulper-pass, sub:pv-gulper-total, sub:pv-banjo-pass, sub:pv-banjo-total,
      sub:pv-example-score, sub:pv-example-distance .

  sub:pv-families a schema:PropertyValue ;
    schema:propertyID "held-out-family-count" ; schema:value 168 ;
    schema:description "Number of held-out families, scored family-out in a blind run of every scorer version (SCORER-EVALUATION.md:14)." .
  sub:pv-real-low a schema:PropertyValue ;
    schema:propertyID "real-organisms-at-or-above-cut-lower-percent" ; schema:value 98 ;
    schema:description "Lowest percentage, across versions, of real held-out organisms scoring at or above the cut (SCORER-EVALUATION.md:45)." .
  sub:pv-real-high a schema:PropertyValue ;
    schema:propertyID "real-organisms-at-or-above-cut-upper-percent" ; schema:value 99.6 ;
    schema:description "Highest percentage, across versions, of real held-out organisms scoring at or above the cut (SCORER-EVALUATION.md:45)." .
  sub:pv-cut a schema:PropertyValue ;
    schema:propertyID "plausibility-cut" ; schema:value 0.5 ;
    schema:description "Plausibility score cut used for both real organisms and negatives (SCORER-EVALUATION.md:45, 46)." .
  sub:pv-neg-low a schema:PropertyValue ;
    schema:propertyID "negatives-below-cut-lower-percent" ; schema:value 12 ;
    schema:description "Lowest percentage of negatives scoring below the cut across versions (SCORER-EVALUATION.md:46)." .
  sub:pv-neg-high a schema:PropertyValue ;
    schema:propertyID "negatives-below-cut-upper-percent" ; schema:value 17 ;
    schema:description "Highest percentage of negatives scoring below the cut across versions (SCORER-EVALUATION.md:46)." .
  sub:pv-min-items a schema:PropertyValue ;
    schema:propertyID "minimum-real-items-per-family" ; schema:value 3 ;
    schema:description "Families listed as weak have at least this many real items (SCORER-EVALUATION.md:183)." .
  sub:pv-share-threshold a schema:PropertyValue ;
    schema:propertyID "family-plausible-share-threshold-percent" ; schema:value 80 ;
    schema:description "A family is flagged when fewer than this percentage of its real items score plausible (SCORER-EVALUATION.md:183)." .
  sub:pv-gulper-pass a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae-items-plausible" ; schema:value 3 ;
    schema:description "Gulper eels (Eurypharyngidae) scoring plausible (SCORER-EVALUATION.md:183)." .
  sub:pv-gulper-total a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae-real-items" ; schema:value 5 ;
    schema:description "Real gulper eel items in the family (SCORER-EVALUATION.md:183)." .
  sub:pv-banjo-pass a schema:PropertyValue ;
    schema:propertyID "aspredinidae-items-plausible" ; schema:value 20 ;
    schema:description "Banjo catfishes (Aspredinidae) scoring plausible (SCORER-EVALUATION.md:183)." .
  sub:pv-banjo-total a schema:PropertyValue ;
    schema:propertyID "aspredinidae-real-items" ; schema:value 29 ;
    schema:description "Real banjo catfish items in the family (SCORER-EVALUATION.md:183)." .
  sub:pv-example-score a schema:PropertyValue ;
    schema:propertyID "fs-05942-plausibility-score" ; schema:value 0.15 ;
    schema:description "Score of fs-05942, a gulper eel, the example low scorer (SCORER-EVALUATION.md:186)." .
  sub:pv-example-distance a schema:PropertyValue ;
    schema:propertyID "fs-05942-nearest-neighbour-distance" ; schema:value 0.96 ;
    schema:description "Distance from fs-05942 to its nearest remaining neighbour, the cutlassfish Lepturacanthus savala, once its family is removed (SCORER-EVALUATION.md:186)." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphi-drafting-agent> ;
    prov:wasDerivedFrom
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:14" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:45" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:46" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:47" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:183" ,
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:186" .
}

sub:pubinfo {
  this: dct:created "2026-11-01T00:00:00Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/delphi-drafting-agent> ;
    rdfs:label "Draft: real organisms scoring plausible is near-worthless evidence for the design scorer" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType delphi:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/design-scorer-evaluation> ;
    rdfs:comment "This is an unsigned draft nanopublication, not published; it carries no signature and has not been reviewed." .

  <https://w3id.org/delphi/resource/domain/design-scorer-evaluation> rdfs:label "Design scorer evaluation" .
}
