sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> a delphi:Claim ;
    rdfs:label "That real held-out organisms score plausible says almost nothing about whether the design scorer works, because negatives score plausible too." ;
    dct:description "Status: a single blind held-out, family-out evaluation reported in the project's own scorer-evaluation document (SCORER-EVALUATION.md, lines 14, 45-47); it is an internal result, not independently replicated or externally reviewed. What it supports: the pass rate of real organisms on the plausibility cut is a non-diagnostic measure, since nearly all real organisms and most negatives land on the plausible side, so every scorer version is close to calling everything plausible. What it does NOT establish: it does not show that any scorer version is bad or useless at ranking or discrimination, it does not show the scorers fail on some other metric, and it does not say which version is best. It only shows that this particular pass rate cannot be used as evidence that a scorer works." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> a delphi:EvidenceItem ;
    rdfs:label "Held-out plausibility cut: nearly all real organisms pass, and few negatives are rejected" ;
    dct:description "Numbers transcribed from SCORER-EVALUATION.md: held-out design at line 14, real-organism and negative shares at lines 45 and 46, the interpretation at line 47, the low-scoring families at line 183, and the gulper-eel example at line 186. Scoring was family-out, so a held-out organism's own family is absent from what the scorer learned from." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#heldOutFamilies> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#realPassLow> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#realPassHigh> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#cut> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#negRejectLow> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#negRejectHigh> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#familyShareThreshold> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#minRealItems> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#gulperPassing> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#gulperTotal> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#banjoPassing> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#banjoTotal> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#exampleScore> ,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#exampleDistance> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#heldOutFamilies> a schema:PropertyValue ;
    schema:propertyID "held-out-family-count" ; schema:value 168 ;
    schema:description "Held-out families scored family-out in the blind run of every scorer version (SCORER-EVALUATION.md:14)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#realPassLow> a schema:PropertyValue ;
    schema:propertyID "real-organisms-at-or-above-cut-lowest-percent" ; schema:value 98 ;
    schema:description "Lowest, across versions, of the percent of real held-out organisms scoring at or above the cut (SCORER-EVALUATION.md:45)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#realPassHigh> a schema:PropertyValue ;
    schema:propertyID "real-organisms-at-or-above-cut-highest-percent" ; schema:value 99.6 ;
    schema:description "Highest, across versions, of the percent of real held-out organisms scoring at or above the cut (SCORER-EVALUATION.md:45)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#cut> a schema:PropertyValue ;
    schema:propertyID "plausibility-cut" ; schema:value 0.5 ;
    schema:description "The plausibility score cut used for both the real-organism and negative shares (SCORER-EVALUATION.md:45-46)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#negRejectLow> a schema:PropertyValue ;
    schema:propertyID "negatives-below-cut-lowest-percent" ; schema:value 12 ;
    schema:description "Lowest, across versions, of the percent of negatives scoring below the cut (SCORER-EVALUATION.md:46)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#negRejectHigh> a schema:PropertyValue ;
    schema:propertyID "negatives-below-cut-highest-percent" ; schema:value 17 ;
    schema:description "Highest, across versions, of the percent of negatives scoring below the cut (SCORER-EVALUATION.md:46)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#familyShareThreshold> a schema:PropertyValue ;
    schema:propertyID "family-plausible-share-threshold-percent" ; schema:value 80 ;
    schema:description "Families are flagged when fewer than this percent of their real items score plausible (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#minRealItems> a schema:PropertyValue ;
    schema:propertyID "minimum-real-items-per-flagged-family" ; schema:value 3 ;
    schema:description "A family is considered only if it has at least this many real items (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#gulperPassing> a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae-real-items-scoring-plausible" ; schema:value 3 ;
    schema:description "Gulper eels (Eurypharyngidae) scoring plausible (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#gulperTotal> a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae-real-items-total" ; schema:value 5 ;
    schema:description "Real gulper-eel items in the family (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#banjoPassing> a schema:PropertyValue ;
    schema:propertyID "aspredinidae-real-items-scoring-plausible" ; schema:value 20 ;
    schema:description "Banjo catfishes (Aspredinidae) scoring plausible (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#banjoTotal> a schema:PropertyValue ;
    schema:propertyID "aspredinidae-real-items-total" ; schema:value 29 ;
    schema:description "Real banjo-catfish items in the family (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#exampleScore> a schema:PropertyValue ;
    schema:propertyID "fs-05942-plausibility-score" ; schema:value 0.15 ;
    schema:description "Score of the gulper eel fs-05942 (SCORER-EVALUATION.md:186)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless#exampleDistance> a schema:PropertyValue ;
    schema:propertyID "fs-05942-nearest-neighbour-distance" ; schema:value 0.96 ;
    schema:description "Distance from fs-05942 to its nearest remaining neighbour, the cutlassfish Lepturacanthus savala, once its family is removed (SCORER-EVALUATION.md:186)." .
}

