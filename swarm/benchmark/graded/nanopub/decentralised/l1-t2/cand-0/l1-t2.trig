@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> a delphi:Claim ;
    rdfs:label "That real held-out organisms score plausible says almost nothing about whether the design scorer works, because negatives score plausible too." ;
    dct:description "Status: a descriptive observation reported in the scorer evaluation document (SCORER-EVALUATION.md, lines 14, 45, 46, 47), from a blind family-out held-out run of every scorer version over 168 families; it is a reading of that document's own summary, not an independent replication. What it does NOT establish: it does not show that any scorer version is useless or broken, and it does not measure how well a scorer separates real organisms from negatives by ranking or by any threshold-free metric; it only shows that the pass rate on real organisms at the 0.5 cut is uninformative on its own, since the cut passes nearly everything. The few low-scoring families (SCORER-EVALUATION.md:183, :186) are anecdotal and do not explain the pattern." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> a delphi:EvidenceItem ;
    rdfs:label "Held-out plausibility scores: nearly all real organisms pass the 0.5 cut, and most negatives pass it as well." ;
    dct:description "Taken from SCORER-EVALUATION.md: lines 14 (held-out design), 45 and 46 (pass rates on real organisms and on negatives at the 0.5 cut), 47 (the document's own conclusion that every version is close to calling everything plausible), 183 (families with fewer than 80 % plausible) and 186 (the gulper eel example)." ;
    schema:additionalProperty sub:pv-families, sub:pv-real-low, sub:pv-real-high, sub:pv-cut, sub:pv-neg-low, sub:pv-neg-high, sub:pv-min-items, sub:pv-threshold, sub:pv-eury-pass, sub:pv-eury-total, sub:pv-aspr-pass, sub:pv-aspr-total, sub:pv-example-id, sub:pv-example-score, sub:pv-example-dist .

  sub:pv-families a schema:PropertyValue ;
    schema:propertyID "held-out-family-count" ;
    schema:value 168 ;
    schema:description "Held-out families, scored family-out in a blind run of every scorer version (SCORER-EVALUATION.md:14)." .

  sub:pv-real-low a schema:PropertyValue ;
    schema:propertyID "real-organisms-at-or-above-cut-lowest-percent" ;
    schema:value 98 ;
    schema:description "Lower end of the percent of real held-out organisms scoring at or above the cut across versions (SCORER-EVALUATION.md:45)." .

  sub:pv-real-high a schema:PropertyValue ;
    schema:propertyID "real-organisms-at-or-above-cut-highest-percent" ;
    schema:value 99.6 ;
    schema:description "Upper end of the same percent range (SCORER-EVALUATION.md:45)." .

  sub:pv-cut a schema:PropertyValue ;
    schema:propertyID "plausibility-cut" ;
    schema:value 0.5 ;
    schema:description "Plausibility score cut used in the pass rates (SCORER-EVALUATION.md:45, :46)." .

  sub:pv-neg-low a schema:PropertyValue ;
    schema:propertyID "negatives-below-cut-lowest-percent" ;
    schema:value 12 ;
    schema:description "Lower end of the percent of negatives scoring below the cut, so the scorer rejects only this few (SCORER-EVALUATION.md:46)." .

  sub:pv-neg-high a schema:PropertyValue ;
    schema:propertyID "negatives-below-cut-highest-percent" ;
    schema:value 17 ;
    schema:description "Upper end of the percent of negatives scoring below the cut (SCORER-EVALUATION.md:46)." .

  sub:pv-min-items a schema:PropertyValue ;
    schema:propertyID "minimum-real-items-per-family-for-low-list" ;
    schema:value 3 ;
    schema:description "Families listed as low had at least this many real items (SCORER-EVALUATION.md:183)." .

  sub:pv-threshold a schema:PropertyValue ;
    schema:propertyID "family-plausible-share-threshold-percent" ;
    schema:value 80 ;
    schema:description "A family is listed when fewer than this percent of its real items score plausible (SCORER-EVALUATION.md:183)." .

  sub:pv-eury-pass a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae-plausible-items" ;
    schema:value 3 ;
    schema:description "Real Eurypharyngidae (gulper eels) items scoring plausible (SCORER-EVALUATION.md:183)." .

  sub:pv-eury-total a schema:PropertyValue ;
    schema:propertyID "eurypharyngidae-real-items" ;
    schema:value 5 ;
    schema:description "Real Eurypharyngidae items in total (SCORER-EVALUATION.md:183)." .

  sub:pv-aspr-pass a schema:PropertyValue ;
    schema:propertyID "aspredinidae-plausible-items" ;
    schema:value 20 ;
    schema:description "Real Aspredinidae (banjo catfishes) items scoring plausible (SCORER-EVALUATION.md:183)." .

  sub:pv-aspr-total a schema:PropertyValue ;
    schema:propertyID "aspredinidae-real-items" ;
    schema:value 29 ;
    schema:description "Real Aspredinidae items in total (SCORER-EVALUATION.md:183)." .

  sub:pv-example-id a schema:PropertyValue ;
    schema:propertyID "example-low-scorer-identifier" ;
    schema:value "fs-05942" ;
    schema:description "Identifier of the example low-scoring gulper eel (SCORER-EVALUATION.md:186); the numeric part is 05942." .

  sub:pv-example-score a schema:PropertyValue ;
    schema:propertyID "example-low-scorer-plausibility" ;
    schema:value 0.15 ;
    schema:description "Plausibility score of fs-05942 (SCORER-EVALUATION.md:186)." .

  sub:pv-example-dist a schema:PropertyValue ;
    schema:propertyID "example-nearest-neighbour-distance" ;
    schema:value 0.96 ;
    schema:description "Distance from fs-05942 to its nearest remaining neighbour, the cutlassfish Lepturacanthus savala, once its family is removed (SCORER-EVALUATION.md:186)." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/claude-drafting-agent> ;
    prov:wasDerivedFrom "sim-engine/validate/evaluation/SCORER-EVALUATION.md:14",
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:45",
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:46",
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:47",
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:183",
      "sim-engine/validate/evaluation/SCORER-EVALUATION.md:186" .
}

sub:pubinfo {
  this: dct:created "2026-11-01T00:00:00Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/claude-drafting-agent> ;
    rdfs:label "Draft: real organisms scoring plausible is near-worthless evidence for the design scorer" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType delphi:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/design-scorer-evaluation> ;
    rdfs:comment "This is an unsigned draft nanopublication about the scorer pass-rate finding; it has not been signed and is not published." .

  <https://w3id.org/delphi/resource/domain/design-scorer-evaluation> rdfs:label "Design scorer evaluation" .
}
