@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/high-composite-with-failing-gates> a delphi:Claim ;
    rdfs:label "On the winged-zebrafish headline run the scorer's composite is 0.878 and flagged plausible, yet two of five gates fail, two cannot be assessed, and the validator withholds the word \"validated\"." ;
    dct:description "Status: an observed result from one run (generated=winged-zebrafish, base=zebrafish-adult), recorded from the fixture swarm/benchmark/fixtures/gt-l4-t1.json. The high composite (0.878, plausible true, scorer version 1.0.0) is carried through for reference only and is not the report's verdict; no gate feeds it. It does NOT establish that the winged zebrafish glides at least 5 m from a 1 m launch or survives 10-30 C as an adult: physics_check and functional_resolution fail, genotype_similarity and lean_check could not be assessed, and cell, tissue and organ_system scales were not assessed. It does not show the composite is wrong in general, and it does not generalise beyond this single run." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates> .

  <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates> a delphi:EvidenceItem ;
    rdfs:label "Gate outcomes, scorer composite and withheld verdict for the winged-zebrafish run in gt-l4-t1.json" ;
    dct:description "From swarm/benchmark/fixtures/gt-l4-t1.json#results: for the desired phenotype \"a zebrafish that glides at least 5 m from a 1 m launch and survives 10-30 C as an adult\", phenotype_similarity passed, functional_resolution failed, physics_check failed, genotype_similarity and lean_check could not be assessed. From #composite_score_from_the_scorer: composite 0.878, plausible true, version 1.0.0, not the verdict. From #verdict: word_validated_withheld is true because 2 gate(s) failed, 2 could not be assessed, 3 biological scale(s) (cell, tissue, organ_system) could not be assessed and no sequence was compared at any locus. From sim-engine/validate-cli.mjs:17: exit code 1 means a gate failed." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/composite>,
      <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/gates-failed>,
      <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/gates-not-assessed>,
      <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/scales-not-assessed>,
      <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/exit-code> .

  <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/composite> a schema:PropertyValue ;
    schema:propertyID "scorer_composite" ;
    schema:value 0.878 ;
    schema:description "Scorer composite (plausible true, version 1.0.0), reference only, no gate feeds it; locator swarm/benchmark/fixtures/gt-l4-t1.json#composite_score_from_the_scorer." .

  <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/gates-failed> a schema:PropertyValue ;
    schema:propertyID "gates_failed" ;
    schema:value 2 ;
    schema:description "Gates that failed (functional_resolution, physics_check); locator swarm/benchmark/fixtures/gt-l4-t1.json#results." .

  <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/gates-not-assessed> a schema:PropertyValue ;
    schema:propertyID "gates_not_assessed" ;
    schema:value 2 ;
    schema:description "Gates that could not be assessed (genotype_similarity, lean_check); locator swarm/benchmark/fixtures/gt-l4-t1.json#verdict.withheld_because." .

  <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/scales-not-assessed> a schema:PropertyValue ;
    schema:propertyID "scales_not_assessed" ;
    schema:value 3 ;
    schema:description "Biological scales not assessed (cell, tissue, organ_system); locator swarm/benchmark/fixtures/gt-l4-t1.json#verdict.scales_not_assessed." .

  <https://w3id.org/delphi/resource/evidence/high-composite-with-failing-gates/exit-code> a schema:PropertyValue ;
    schema:propertyID "cli_exit_code" ;
    schema:value 1 ;
    schema:description "CLI exit code for this run: 1 means a gate failed (0 all passed, 2 nothing failed but something not assessable); locator sim-engine/validate-cli.mjs:17." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/claude-sonnet-5-5-agent-2> ;
    prov:wasDerivedFrom
      "swarm/benchmark/fixtures/gt-l4-t1.json#results",
      "swarm/benchmark/fixtures/gt-l4-t1.json#composite_score_from_the_scorer",
      "swarm/benchmark/fixtures/gt-l4-t1.json#verdict.word_validated_withheld",
      "swarm/benchmark/fixtures/gt-l4-t1.json#verdict.withheld_because",
      "swarm/benchmark/fixtures/gt-l4-t1.json#verdict.scales_not_assessed",
      "sim-engine/validate-cli.mjs:17" .
}

sub:pubinfo {
  this: dct:created "2026-11-01T00:00:00Z"^^xsd:dateTime ;
    dct:creator <https://w3id.org/delphi/resource/agent/claude-sonnet-5-5-agent-2> ;
    rdfs:label "Draft: high scorer composite alongside failing gates on the winged-zebrafish run" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    npx:hasNanopubType delphi:Claim ;
    npx:introduces <https://w3id.org/delphi/resource/claim/high-composite-with-failing-gates> ;
    delphi:domain <https://w3id.org/delphi/resource/domain/design-validation> ;
    rdfs:comment "Unsigned draft, not published: this nanopublication carries no signature and has not been submitted to any registry." .

  <https://w3id.org/delphi/resource/domain/design-validation> rdfs:label "Design validation" .
}
