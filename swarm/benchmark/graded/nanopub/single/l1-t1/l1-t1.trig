sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/composite-never-beat-its-strongest-term> a delphi:Claim ;
    rdfs:label "The design scorer's composite rank_score did not beat its own strongest single term, the joint Mahalanobis term, on the primary ranking endpoint." ;
    dct:description "STATUS: an observed result from one blind, family-out held-out run of scorer v1.3.0 over 168 held-out families, scored by an evaluator who built neither the scorer nor the benchmark (SCORER-EVALUATION.md:13, :14). The composite beats nearest-neighbour distance (0.875, +0.032) but not the joint term alone, whose own score is 0.883 (SCORER-EVALUATION.md:33, :35, :38). This is a single-run, single-version observation; the dossier gives no figures for other scorer versions. DOES NOT ESTABLISH: that the composite is truly worse than the joint term on the primary endpoint, because the interval for the difference (-0.008, CI -0.020 to 0.002) includes zero; that the other components are useless, since they earn their place on secondary endpoints S4 and S5 which the joint term alone fails (SCORER-EVALUATION.md:43); or that the pattern holds beyond these 168 families. The only significant gap is over all held-out items, where the composite is worse by -0.007 (CI -0.013 to -0.002) (SCORER-EVALUATION.md:36)." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term> a delphi:EvidenceItem ;
    rdfs:label "Blind held-out comparison of rank_score against nearest-neighbour distance and the joint Mahalanobis term alone, scorer v1.3.0" ;
    dct:description "Numbers transcribed from sim-engine/validate/evaluation/SCORER-EVALUATION.md (lines 13, 14, 33, 35, 36, 38, 43). All figures come from the blind held-out run of the scorer version, 168 families, scored family-out; dev results are not counted." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/families> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/rank-score> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-diff> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-ci> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-diff> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-ci> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-items-diff> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-items-ci> ,
      <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-score> .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/families> a schema:PropertyValue ;
    schema:propertyID "held-out-family-count" ;
    schema:value "168" ;
    schema:description "Held-out families scored family-out in the blind run (SCORER-EVALUATION.md:14)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/rank-score> a schema:PropertyValue ;
    schema:propertyID "rank-score-primary-endpoint-v1.3.0" ;
    schema:value "0.875" ;
    schema:description "Primary-endpoint score of v1.3.0 rank_score (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-diff> a schema:PropertyValue ;
    schema:propertyID "rank-score-minus-nearest-neighbour" ;
    schema:value "+0.032" ;
    schema:description "Difference of rank_score over nearest-neighbour distance on the primary endpoint (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/nn-ci> a schema:PropertyValue ;
    schema:propertyID "rank-score-minus-nearest-neighbour-ci" ;
    schema:value "0.026 to 0.040" ;
    schema:description "Confidence interval for the nearest-neighbour difference (SCORER-EVALUATION.md:33)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-diff> a schema:PropertyValue ;
    schema:propertyID "rank-score-minus-joint-term-primary" ;
    schema:value "-0.008" ;
    schema:description "Difference of rank_score versus the joint Mahalanobis term alone on the primary endpoint; not a win for the composite (SCORER-EVALUATION.md:35)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-ci> a schema:PropertyValue ;
    schema:propertyID "rank-score-minus-joint-term-primary-ci" ;
    schema:value "-0.020 to 0.002" ;
    schema:description "Confidence interval for that difference; it spans zero (SCORER-EVALUATION.md:35)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-items-diff> a schema:PropertyValue ;
    schema:propertyID "rank-score-minus-joint-term-all-items" ;
    schema:value "-0.007" ;
    schema:description "Difference over all held-out items; the composite is significantly worse than the joint term alone (SCORER-EVALUATION.md:36)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/all-items-ci> a schema:PropertyValue ;
    schema:propertyID "rank-score-minus-joint-term-all-items-ci" ;
    schema:value "-0.013 to -0.002" ;
    schema:description "Confidence interval for the all-items difference (SCORER-EVALUATION.md:36)." .

  <https://w3id.org/delphi/resource/evidence/composite-never-beat-its-strongest-term/joint-score> a schema:PropertyValue ;
    schema:propertyID "joint-term-alone-primary-endpoint" ;
    schema:value "0.883" ;
    schema:description "Primary-endpoint score of the joint Mahalanobis term used alone; it passes all three primary endpoints by itself (SCORER-EVALUATION.md:38)." .
}

