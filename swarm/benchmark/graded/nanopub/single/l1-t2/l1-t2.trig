sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/real-organisms-score-plausible-is-near-worthless> a delphi:Claim ;
    rdfs:label "That real held-out organisms score plausible says almost nothing about whether the design scorer works, because negatives score plausible too." ;
    dct:description "Status: an observation from one blind, family-out held-out evaluation (168 held-out families, every scorer version), as recorded in SCORER-EVALUATION.md lines 14 and 45-47; it is a reading of that report, not an independently replicated result. Every version is close to calling everything plausible: 98 to 99.6 % of real organisms are at or above the 0.5 cut, but only 12 to 17 % of negatives fall below it. What this does NOT establish: it does not show that any scorer is useless or wrong, it does not measure discrimination by any other metric, and it does not say how the scorers rank against each other; it only shows that the share of real organisms scoring high is not evidence of a working scorer. The per-family low scorers (locators :183 and :186) are illustrations, not a causal explanation." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless> a delphi:EvidenceItem ;
    rdfs:label "Plausibility pass rate for real organisms versus negatives at the 0.5 cut, held-out family-out run" ;
    dct:description "Figures taken from SCORER-EVALUATION.md (locators sim-engine/validate/evaluation/SCORER-EVALUATION.md:14, :45, :46, :47, :183, :186). Real held-out organisms nearly all pass the cut, while few negatives are rejected by it, so the pass rate on real organisms cannot separate a working scorer from one that accepts everything." ;
    schema:additionalProperty
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-families>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-real-low>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-real-high>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-neg-low>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-neg-high>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-cut>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-minitems>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-famthresh>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-eury-hit>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-eury-n>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-aspr-hit>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-aspr-n>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-gulper-score>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-gulper-dist>,
      <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-gulper-id> .

  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-families> a schema:PropertyValue ;
    schema:propertyID "heldOutFamilies" ; schema:value 168 ;
    schema:description "Held-out families scored family-out in the blind run of every scorer version (SCORER-EVALUATION.md:14)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-real-low> a schema:PropertyValue ;
    schema:propertyID "realAtOrAboveCutLowPercent" ; schema:value 98 ;
    schema:description "Lowest share, in percent, of real held-out organisms scoring at or above the 0.5 cut across versions (SCORER-EVALUATION.md:45)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-real-high> a schema:PropertyValue ;
    schema:propertyID "realAtOrAboveCutHighPercent" ; schema:value 99.6 ;
    schema:description "Highest share, in percent, of real held-out organisms scoring at or above the 0.5 cut across versions (SCORER-EVALUATION.md:45)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-neg-low> a schema:PropertyValue ;
    schema:propertyID "negativesBelowCutLowPercent" ; schema:value 12 ;
    schema:description "Lower end of the range, in percent, of negatives scoring below the 0.5 cut (SCORER-EVALUATION.md:46)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-neg-high> a schema:PropertyValue ;
    schema:propertyID "negativesBelowCutHighPercent" ; schema:value 17 ;
    schema:description "Upper end of the range, in percent, of negatives scoring below the 0.5 cut (SCORER-EVALUATION.md:46)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-cut> a schema:PropertyValue ;
    schema:propertyID "plausibilityCut" ; schema:value 0.5 ;
    schema:description "The plausibility score cut used for both real organisms and negatives (SCORER-EVALUATION.md:45-46)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-minitems> a schema:PropertyValue ;
    schema:propertyID "minRealItemsPerFamily" ; schema:value 3 ;
    schema:description "Minimum number of real items for a family to be listed among low-scoring families (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-famthresh> a schema:PropertyValue ;
    schema:propertyID "familyPlausibleSharePercentThreshold" ; schema:value 80 ;
    schema:description "Families with fewer than this percent of real items scoring plausible are flagged (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-eury-hit> a schema:PropertyValue ;
    schema:propertyID "eurypharyngidaePlausible" ; schema:value 3 ;
    schema:description "Eurypharyngidae (gulper eels): real items scoring plausible (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-eury-n> a schema:PropertyValue ;
    schema:propertyID "eurypharyngidaeRealItems" ; schema:value 5 ;
    schema:description "Eurypharyngidae (gulper eels): total real items (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-aspr-hit> a schema:PropertyValue ;
    schema:propertyID "aspredinidaePlausible" ; schema:value 20 ;
    schema:description "Aspredinidae (banjo catfishes): real items scoring plausible (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-aspr-n> a schema:PropertyValue ;
    schema:propertyID "aspredinidaeRealItems" ; schema:value 29 ;
    schema:description "Aspredinidae (banjo catfishes): total real items (SCORER-EVALUATION.md:183)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-gulper-score> a schema:PropertyValue ;
    schema:propertyID "fs05942Score" ; schema:value 0.15 ;
    schema:description "Plausibility score of fs-05942, a gulper eel, an example low scorer (SCORER-EVALUATION.md:186)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-gulper-dist> a schema:PropertyValue ;
    schema:propertyID "fs05942NearestNeighbourDistance" ; schema:value 0.96 ;
    schema:description "Distance from fs-05942 to its nearest remaining neighbour, the cutlassfish Lepturacanthus savala, once its family is removed (SCORER-EVALUATION.md:186)." .
  <https://w3id.org/delphi/resource/evidence/real-organisms-score-plausible-is-near-worthless/p-gulper-id> a schema:PropertyValue ;
    schema:propertyID "exampleItemId" ; schema:value "fs-05942" ;
    schema:description "Identifier of the example low-scoring gulper eel item (SCORER-EVALUATION.md:186); numeric part 05942." .
}

