@prefix this: <http://purl.org/nanopub/temp/np1/> .
@prefix sub: <http://purl.org/nanopub/temp/np1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://w3id.org/delphi/resource/claim/holdout-triage-coverage-2026-10-31> a delphi:Claim ;
    rdfs:label "14 of 16 completed claim tests contain no bird rows, so the Aves exam can enter only 2" ;
    dct:description "Status: established by inspection of each test's result.json datasets and analysis.py on 2026-10-31. The completed tests draw on humans, Drosophila, a parasitoid wasp, spiders, North Sea fish, gastropods, ammonoids, carnivorans and cetaceans, geological and climate series, plants, and two cross-species tables (Buffalo 2021 diversity; COMADRE matrices) that are the only ones with bird rows. This is evidence about the inventory's coverage: a held-out clade can only examine tests whose data span it. It does not establish anything about the tests' verdicts, which stand as the builders reported them, unexamined. Reasons per test are in holdout/exam-results/not-applicable.json." ;
    delphi:hasEvidence <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> ;
    prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/delphisci-holdout-assessor-claude-fable-5-1> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> a delphi:EvidenceItem ;
    rdfs:label "Triage of 16 completed claim tests: 2 examined on birds, 14 not applicable" ;
    dct:description "Completed claim tests whose data contain no organism-level rows of the held-out clade (Aves), so the exam cannot enter them and no result is written. Checked by the holdout thread against each test’s result.json datasets, its analysis.py (no class filter or --exam mode) and the leak check. Verdicts shown are the builders’ own, unexamined." ;
    delphi:statisticalTest "Enumeration, no statistics" ;
    rdfs:seeAlso <https://delphi-mission-control.ashenoy000.workers.dev/t/holdout/data.json> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> schema:additionalProperty sub:status .
  sub:status a schema:PropertyValue ;
    schema:propertyID "status" ;
    schema:value "established by inspection of each test's datasets and analysis script" ;
    schema:description "Status of this evidence item in the words of holdout/EXAM.md and AGENTS.md A10" .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> schema:additionalProperty sub:m1 .
  sub:m1 a schema:PropertyValue ;
    schema:propertyID "n_completed_claim_tests" ;
    schema:value "16"^^xsd:integer ;
    schema:description "completed claim tests under claim-tests/ at build time" .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> schema:additionalProperty sub:m2 .
  sub:m2 a schema:PropertyValue ;
    schema:propertyID "n_tests_examined_on_aves" ;
    schema:value "2"^^xsd:integer ;
    schema:description "tests with bird rows, examined on the frozen roster" .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> schema:additionalProperty sub:m3 .
  sub:m3 a schema:PropertyValue ;
    schema:propertyID "n_tests_not_applicable" ;
    schema:value "14"^^xsd:integer ;
    schema:description "tests with no bird rows" .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> schema:additionalProperty sub:m4 .
  sub:m4 a schema:PropertyValue ;
    schema:propertyID "n_not_applicable_human_only" ;
    schema:value "4"^^xsd:integer ;
    schema:description "of those, tests on Homo sapiens only" .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> schema:additionalProperty sub:m5 .
  sub:m5 a schema:PropertyValue ;
    schema:propertyID "n_not_applicable_data_blocked" ;
    schema:value "2"^^xsd:integer ;
    schema:description "of those, tests whose data download was blocked (HTTP 403) so nothing was measured" .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> dct:references <https://w3id.org/delphi/resource/claim/darwin1859-ch09-03> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> dct:references <https://w3id.org/delphi/resource/claim/darwin1859-ch11-13> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> dct:references <https://w3id.org/delphi/resource/claim/thompson1917-ch03-07> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> dct:references <https://w3id.org/delphi/resource/claim/thompson1917-ch04-13> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> dct:references <https://w3id.org/delphi/resource/claim/fisher-infinitesimal> .
  <https://w3id.org/delphi/resource/evidence/holdout-triage-2026-10-31> dct:references <https://w3id.org/delphi/resource/claim/fisher-sex-ratio> .
