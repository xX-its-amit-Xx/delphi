# The cookbook records the sha256 of the npm tarball it was run with, and `cookbook.mjs --check`
# fails if the package no longer packs to those bytes. So the files that ship in the package must
# have the same line endings on every machine, whatever core.autocrlf says there.
kernel.mjs text eol=lf
package.json text eol=lf
README.md text eol=lf
embed/delphi.mjs text eol=lf
embed/graph.mjs text eol=lf
embed/best-practices.mjs text eol=lf
embed/lean-check.mjs text eol=lf
embed/README.md text eol=lf
