 "failed_theorems": [
  {
   "failure_id": "ft-design-validation-closeness",
   "version": "1.0.0",
   "reason": "measurement-does-not-exist",
   "statement_en": "That this project can DESIGN an organism, operationalised as: the designed \"winged zebrafish\" is measurably close to a real flying fish on the ten pre-registered axes.",
   "what_survives": "The method survives and so does the finding. Pre-registering the axes is what made the result legible: the count of UNSCOREABLE parameters became the headline rather than a quiet omission, and the gate's failure to separate the design from the real animal was caught rather than reported as a pass. The durable scientific finding is that the design's phenotypic claim was never this project's to validate -- it is Daane et al. 2021's own published double heterozygote -- and that the single measurement which would let anyone score it, the pectoral fin length of that fish, has never been published as a number. The 1-of-74 genetic overlap stands as a real, if small, number, and the one convergent locus is a genuine hit.",
   "became_open_question": null,
   "content_hash": "c6993807b3513dd0b81a7cd1ed3deb79eedd0d4b69b50bb0929c844d578c7dbf"
  },
  {
   "failure_id": "ft-glider-interface-convergence",
   "version": "1.0.0",
   "reason": "contradicted-by-data",
   "statement_en": "That independently evolved gliding lineages converge at the sequence level at protein-interface positions: some interface position carries, in gliders, a residue not found in non-gliders.",
   "what_survives": "The null is real within its stated limits, and the limits are recorded rather than glossed: a gap column counts as a gap and not a difference; tblastn projections are excluded; the structures are human and mouse, so every fish, reptile and amphibian residue is reached by a cross-species jump; and interface membership is a 4.0 A cutoff in ONE deposited conformation, so a residue just outside the cutoff, or one that only contacts its partner in another state, counts as non-interface here. What also survives is a self-correction worth more than the null: an earlier version of this test produced \"10 interface positions separating gliders\" from a single low-identity, name-matched colugo sequence, and the thread caught and discarded it rather than publishing it. And the one real convergence this project holds -- lat4a F326L in flying fishes and gliding halfbeaks -- survives untouched; it simply does not extend to mammals, and it sits 20 A from the substrate site with no transport assay in any species.",
   "became_open_question": null,
   "content_hash": "66e2e452c1045d788b601b5bcbc761422ad615c95a379e53f89e5102c8d57735"
  },
  {
   "failure_id": "ft-teleost-sleep-law",
   "version": "1.0.0",
   "reason": "abandoned-for-lack-of-a-constant",
   "statement_en": "That there is a quantitative sleep law for a teleost: sleep time predicted from body or brain mass, as Savage and West 2007 do for mammals.",
   "what_survives": "The refusal is the result. lean/Delphi/Perturb.lean carries the gap explicitly -- \"Sleep: NO LAW ... Nothing is invented: the Studio's sleep and day/night perturbations have no Lean row\" -- and the same section records that grip and predator escape likewise have no law. A Studio perturbation with no row is honest; a row fitted to a definition-dependent number would have been a law that looked checkable and was not. The measurements themselves survive as recorded observations in sim-engine/scenarios/sleep.mjs, side by side and never mixed.",
   "became_open_question": "oq-larval-sleep-definition",
   "content_hash": "b37c115baf6427498b4727a6a0af23b19c9ef57e887b3dbd0d73428ef67c8aef"
  }
 ],
