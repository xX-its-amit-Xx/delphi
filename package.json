{
  "name": "delphisci-mcp",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "MCP server and CLI for querying delphisci claims (nanopubs, math, assessment rankings, the claim graph's truth scores) and the project's versioned Lean laws (lean_* tools).",
  "bin": {
    "delphisci-mcp": "mcp/server.mjs"
  },
  "files": [
    "mcp/*.mjs",
    "docs/claims.json",
    "organisms/merged/*.json",
    "*/nanopubs/unsigned/*.trig",
    "*/nanopubs/*-unsigned/*.trig",
    "lib/lean-source.mjs",
    "lib/lean-scope.mjs",
    "sim-engine/tools/lean-tools.mjs",
    "sim-engine/lib/envelope.mjs",
    "sim-engine/lean-cli.mjs",
    "lean/registry/registry-lib.mjs",
    "lean/registry/laws/*.json",
    "lean/registry/lawsets/*.json",
    "lean/registry/law-versions/*.json",
    "lean/laws.json",
    "lean/constraints.json",
    "lean/empirical.json",
    "lean/eliminate/browser-check.mjs",
    "lean/Delphi/**/*.lean",
    "pipeline/leanbio/*.mjs",
    "pipeline/leanbio/*.json",
    "pipeline/leanbio/out/queue.json",
    "pipeline/leanbio/out/records.json",
    "pipeline/leanbio/cache/*.json",
    "holdout/exam.json",
    "holdout/split.json",
    "organisms/merged/taxa.json",
    "sim-engine/tools/studio.mjs",
    "sim-engine/tools/validate-tools.mjs",
    "sim-engine/tools/omics-tools.mjs",
    "sim-engine/lib/*.mjs",
    "sim-engine/params/*.json",
    "sim-engine/scenarios/*.mjs",
    "sim-engine/validate/*.mjs",
    "sim-engine/validate/score-weights*.json",
    "sim-engine/validate/data/**",
    "sim-engine/validate/cache/**",
    "anatomy-model/parametric/organisms/*.json",
    "anatomy-model/parametric/resolved/*.json",
    "anatomy-model/parametric/stages.json",
    "conditions/baseline.json",
    "dashboard/public/blueprint3d/data.json",
    "dashboard/public/blueprint3d/model/*-manifest.json",
    "dashboard/public/blueprint3d/partedit.js",
    "development/trajectory.mjs",
    "development/zebrafish/trajectory.mjs",
    "physiology/*.js",
    "genotype/map.vetted.slim.json",
    "sequences/progression.json",
    "sequences/alignments/*.json",
    "omics/index/**",
    "genotype/causal-chains.json",
    "genotype/interventions.json",
    "genotype/pathways.slim.json",
    "genotype/sequence-layer.json",
    "sim-engine/tools/pipeline-tools.mjs",
    "sim-engine/tools/physics-tools.mjs",
    "sim-engine/tools/functional-tools.mjs",
    "sim-engine/tools/editplan-tools.mjs",
    "sim-engine/tools/spec-tools.mjs",
    "sim-engine/validate/pipeline/*.mjs",
    "sim-engine/validate/pipeline/coverage-gaps.json",
    "sim-engine/validate/physics/*.mjs",
    "sim-engine/validate/functional/*.mjs",
    "sim-engine/validate/functional/data/*.json",
    "sim-engine/validate/functional/compensation/*.mjs",
    "sim-engine/validate/functional/compensation/*.json",
    "sim-engine/validate/editplan/*.mjs",
    "dashboard/public/t/physics/sim/creatures.js",
    "sim-engine/validation/studio-results.json",
    "physics/glide-data.csv",
    "genotype/cache/daane2021_fin_ratios.json",
    "sequences/genes.json",
    "omics/*/MANIFEST.json",
    "lean/registry/open-questions/*.mjs",
    "lean/registry/open-questions/questions/*.json",
    "lean/registry/open-questions/failed/*.json",
    "lean/registry/open-questions/requirements/*.json",
    "lean/registry/open-questions/not-checkable/*.json",
    "omics/genes.json",
    "lean/registry/CHANGELOG.md",
    "pipeline/leanbio/capability-map/*.mjs",
    "pipeline/leanbio/capability-map/*.json",
    "sim-engine/contract.json"
  ],
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "cli": "node mcp/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "oxigraph": "^0.5.13",
    "zod": "^4.6.7"
  }
}
